            },
            "url": {
              "raw": "{{base_url}}/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "otp",
                "verify"
              ]
            },
            "description": "Validate the OTP code entered or spoken by the user."
          }
        }
      ]
    },
